        <section id="problem" aria-labelledby="problem-title">
            <div class="container">
                <div class="section-header reveal">
                    <p class="section-label">O problema</p>
                    <h2 class="section-title" id="problem-title">Você sabe quanto ganhou esse mês?</h2>
                    <p class="section-sub">
