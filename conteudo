    <style>
        /* ============================================================
         TOKENS & RESET
      ============================================================ */
        :root {
            color-scheme: dark;
            --bg: #0a0d0f;
            --surface: #111518;
            --surface2: #181d21;
            --border: rgba(255, 255, 255, 0.07);
            --accent: #00e87a;
            --accent2: #00b85f;
            --muted: #8791a0;
            /* era #5a6370 (contraste ~3:1); agora ~5.9:1 */
            --text: #e8edf2;
            --text2: #a3adb8;
            --gold: #f5c842;
            --radius-lg: 22px;
            --ease: cubic-bezier(0.22, 1, 0.36, 1);
            --font-display: "Work Sans", "Segoe UI", system-ui, sans-serif;
            --font-body: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 24px;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: var(--font-body);
            font-size: 16px;
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* Títulos: fonte mais compacta, peso 700 e tracking mais suave */
        h1,
        h2,
        h3,
        h4 {
            font-family: var(--font-display);
            font-stretch: 90%;
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.02em;
            text-wrap: balance;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            display: block;
            max-width: 100%;
        }

        ul,
        ol {
            list-style: none;
        }

        :focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 3px;
            border-radius: 6px;
        }

        /* ============================================================
         UTILITIES
      ============================================================ */
        .container {
            width: 100%;
            max-width: 1120px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .section-label {
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 16px;
        }

        /* Reveal: só esconde se JS estiver ativo; usa `translate` para não
         conflitar com o `transform` dos hovers e `animation` para não ser
         sobrescrito pelos `transition` dos componentes. */
        .js .reveal {
            opacity: 0;
        }

        .js .reveal.visible {
            animation-name: reveal-in;
            animation-duration: 0.65s;
            animation-timing-function: var(--ease);
            animation-fill-mode: both;
        }

        @keyframes reveal-in {
            from {
                opacity: 0;
                translate: 0 32px;
            }

            to {
                opacity: 1;
                translate: 0 0;
            }
        }

        .reveal-delay-1 {
            animation-delay: 0.1s;
        }

        .reveal-delay-2 {
            animation-delay: 0.2s;
        }

        .reveal-delay-3 {
            animation-delay: 0.3s;
        }

        .reveal-delay-4 {
            animation-delay: 0.4s;
        }

        /* ============================================================
         BUTTONS
      ============================================================ */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-family: var(--font-display);
            font-stretch: 90%;
            font-weight: 700;
            font-size: 16px;
            border-radius: 100px;
            padding: 14px 32px;
            cursor: pointer;
            border: none;
            text-align: center;
            transition: background 0.2s, box-shadow 0.2s, transform 0.2s, border-color 0.2s;
        }

        .btn-primary {
            background: var(--accent);
            color: #000;
        }

        .btn-primary:hover {
            background: #1fffa0;
            box-shadow: 0 0 32px rgba(0, 232, 122, 0.4);
            transform: translateY(-2px);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-outline {
            background: transparent;
            color: var(--text);
            border: 1.5px solid rgba(255, 255, 255, 0.18);
        }

        .btn-outline:hover {
            border-color: rgba(255, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.04);
        }

        .btn-lg {
            font-size: 17px;
            padding: 18px 40px;
        }

        /* ============================================================
         NAVBAR
      ============================================================ */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 100;
            height: 72px;
            background: var(--bg);
            border-bottom: 1px solid var(--border);
        }

        .navbar__inner {
            max-width: 1100px;
            height: 100%;
            margin: 0 auto;
            padding: 0 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .navbar__logo {
            color: var(--text);
            font-weight: 700;
            font-size: 1.25rem;
            text-decoration: none;
            letter-spacing: -0.02em;
        }

        .navbar__logo span {
            color: var(--accent);
        }

        .navbar__menu {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            list-style: none;
        }

        .navbar__link {
            display: block;
            padding: 0.5rem 0.9rem;
            color: var(--muted);
            text-decoration: none;
            border-radius: 6px;
            font-size: 0.95rem;
            transition: color .2s, background .2s;
        }

        .navbar__link:hover,
        .navbar__link.active {
            color: var(--text);
            background: rgba(255, 255, 255, .06);
        }

        .navbar__link.active {
            box-shadow: inset 0 -2px 0 var(--accent);
            border-radius: 6px 6px 0 0;
        }

        .navbar__cta {
            margin-left: 0.5rem;
            padding: 0.5rem 1.1rem;
            background: var(--accent);
            color: #0b1a13;
            font-weight: 600;
            border-radius: 6px;
            text-decoration: none;
            font-size: 0.95rem;
        }

        a:focus-visible,
        button:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 2px;
        }

        /* Botão hambúrguer */
        .navbar__toggle {
            display: none;
            width: 44px;
            height: 44px;
            background: none;
            border: 0;
            cursor: pointer;
            position: relative;
        }

        .navbar__toggle span,
        .navbar__toggle span::before,
        .navbar__toggle span::after {
            content: "";
            position: absolute;
            left: 10px;
            width: 24px;
            height: 2px;
            background: var(--text);
            border-radius: 2px;
            transition: transform .25s, opacity .25s, top .25s;
        }

        .navbar__toggle span {
            top: 21px;
        }

        .navbar__toggle span::before {
            top: -7px;
            left: 0;
        }

        .navbar__toggle span::after {
            top: 7px;
            left: 0;
        }

        .navbar__toggle[aria-expanded="true"] span {
            background: transparent;
        }

        .navbar__toggle[aria-expanded="true"] span::before {
            top: 0;
            transform: rotate(45deg);
        }

        .navbar__toggle[aria-expanded="true"] span::after {
            top: 0;
            transform: rotate(-45deg);
        }

        /* ---------- MOBILE ---------- */
        @media (max-width: 768px) {
            .navbar__toggle {
                display: block;
            }

            .navbar__menu {
                position: absolute;
                top: var(--nav-h);
                left: 0;
                right: 0;
                flex-direction: column;
                align-items: stretch;
                gap: 0;
                padding: 0.5rem 1.25rem 1.25rem;
                background: var(--bg);
                border-bottom: 1px solid var(--line);
                visibility: hidden;
                opacity: 0;
                transform: translateY(-8px);
                transition: opacity .25s, transform .25s, visibility .25s;
            }

            .navbar__menu.open {
                visibility: visible;
                opacity: 1;
                transform: none;
            }

            .navbar__link {
                padding: 0.9rem 0.5rem;
                border-bottom: 1px solid var(--line);
                border-radius: 0;
            }

            .navbar__link.active {
                box-shadow: none;
                color: var(--accent);
                background: none;
            }

            .navbar__cta {
                margin: 1rem 0 0;
                text-align: center;
                padding: 0.8rem;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            * {
                transition: none !important;
            }
        }

        /* ============================================================
         HERO
      ============================================================ */
        #hero {
            position: relative;
            min-height: 100vh;
            min-height: 100svh;
            display: flex;
            align-items: center;
            padding: 120px 0 80px;
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .hero-bg::before {
            content: "";
            position: absolute;
            top: -20%;
            left: -10%;
            width: 70%;
            height: 70%;
            background: radial-gradient(ellipse at center, rgba(0, 232, 122, 0.13) 0%, transparent 65%);
            animation: drift 8s ease-in-out infinite alternate;
        }

        .hero-bg::after {
            content: "";
            position: absolute;
            bottom: -10%;
            right: -5%;
            width: 55%;
            height: 55%;
            background: radial-gradient(ellipse at center, rgba(0, 184, 95, 0.08) 0%, transparent 65%);
            animation: drift 11s ease-in-out infinite alternate-reverse;
        }

        .hero-image,
        .hero-image img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            z-index: 0;
        }

        /* escurece a imagem e garante leitura do texto */
        .hero-overlay {
            position: absolute;
            inset: 0;
            z-index: 1;
            background:
                linear-gradient(90deg,
                    color-mix(in srgb, var(--bg) 95%, transparent) 0%,
                    color-mix(in srgb, var(--bg) 80%, transparent) 45%,
                    color-mix(in srgb, var(--bg) 45%, transparent) 100%),
                linear-gradient(180deg,
                    transparent 70%,
                    var(--bg) 100%);
        }

        /* brilhos verdes e grid ficam acima da imagem */
        .hero-bg::before,
        .hero-bg::after,
        .hero-grid {
            z-index: 2;
        }

        /* no mobile o texto ocupa a tela toda: overlay mais uniforme */
        @media (max-width: 767px) {
            .hero-overlay {
                background: color-mix(in srgb, var(--bg) 82%, transparent);
            }
        }

        .hero-grid {
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
        }

        @keyframes drift {
            from {
                transform: translate(0, 0) scale(1);
            }

            to {
                transform: translate(3%, 4%) scale(1.05);
            }
        }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 760px;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            border-radius: 100px;
            padding: 7px 16px;
            margin-bottom: 32px;
            font-size: 13px;
            color: var(--text2);
            animation: fadeInDown 0.6s ease both;
        }

        .hero-badge .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent);
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-16px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        .hero-title {
            font-size: clamp(40px, 6.5vw, 76px);
            font-weight: 700;
            font-stretch: 85%;
            letter-spacing: -0.025em;
            line-height: 1.04;
            margin-bottom: 24px;
            animation: fadeInUp 0.7s 0.1s ease both;
        }

        .hero-title .line-green {
            color: var(--accent);
        }

        .hero-sub {
            font-size: clamp(16px, 2vw, 20px);
            color: var(--text2);
            max-width: 560px;
            margin-bottom: 44px;
            line-height: 1.7;
            animation: fadeInUp 0.7s 0.2s ease both;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 16px;
            animation: fadeInUp 0.7s 0.3s ease both;
        }

        .hero-note {
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 48px;
        }

        .hero-social-proof {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            animation: fadeInUp 0.7s 0.4s ease both;
        }

        .avatars {
            display: flex;
        }

        .avatars .av {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 2px solid var(--bg);
            margin-left: -10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            color: #000;
        }

        .avatars .av:first-child {
            margin-left: 0;
        }

        .av-a {
            background: linear-gradient(135deg, #f093fb, #f5576c);
        }

        .av-b {
            background: linear-gradient(135deg, #4facfe, #00f2fe);
        }

        .av-c {
            background: linear-gradient(135deg, #43e97b, #38f9d7);
        }

        .av-d {
            background: linear-gradient(135deg, #fa709a, #fee140);
        }

        .sp-text {
            font-size: 13px;
            color: var(--text2);
        }

        .sp-text strong {
            color: var(--text);
            font-weight: 600;
        }

        .sp-divider {
            width: 1px;
            height: 24px;
            background: var(--border);
        }

        .stars {
            color: var(--gold);
            font-size: 14px;
            letter-spacing: 1px;
        }

        /* ============================================================
         BRANDS
      ============================================================ */
        #brands {
            padding: 32px 0;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .brands-inner {
            display: flex;
            align-items: center;
            gap: 24px 48px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .brands-label {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted);
            white-space: nowrap;
        }

        .brands-list {
            display: flex;
            align-items: center;
            gap: 16px 40px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .brand-logo {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 15px;
            color: var(--muted);
        }

        /* ============================================================
         SECTIONS (header comum)
      ============================================================ */
        #problem,
        #how,
        #benefits,
        #social-proof,
        #pricing,
        #faq,
        #final-cta {
            padding: 100px 0;
        }

        .section-header {
            text-align: center;
            max-width: 600px;
            margin: 0 auto 64px;
        }

        .section-title {
            font-size: clamp(30px, 4vw, 48px);
            letter-spacing: -0.02em;
            margin-bottom: 16px;
        }

        .section-sub {
            font-size: 17px;
            color: var(--text2);
            line-height: 1.7;
        }

        /* ============================================================
         PROBLEM / AGITATION / SOLUTION
      ============================================================ */
        .pas-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2px;
            background: var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .pas-card {
            background: var(--surface);
            padding: 48px 40px;
            transition: background 0.3s;
        }

        .pas-card:hover {
            background: var(--surface2);
        }

        .pas-card--solution {
            grid-column: span 2;
            background: rgba(0, 232, 122, 0.05);
            position: relative;
            overflow: hidden;
        }

        .pas-card--solution:hover {
            background: rgba(0, 232, 122, 0.08);
        }

        .pas-card--solution::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--accent);
        }

        .pas-icon {
            font-size: 36px;
            margin-bottom: 20px;
            display: block;
            line-height: 1.2;
        }

        .pas-label {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .label-problem {
            color: #ff6b6b;
        }

        .label-agitate {
            color: var(--gold);
        }

        .label-solution {
            color: var(--accent);
        }

        .pas-title {
            font-size: clamp(20px, 2.5vw, 26px);
            margin-bottom: 16px;
        }

        .pas-text {
            font-size: 15px;
            color: var(--text2);
            line-height: 1.75;
        }

        .pas-text+.pas-text {
            margin-top: 1em;
        }

        .pain-list {
            margin-top: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .pain-list li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 14px;
            color: var(--text2);
        }

        .pain-list li::before {
            content: "×" / "";
            color: #ff6b6b;
            font-weight: 700;
            font-size: 16px;
            line-height: 1.4;
            flex-shrink: 0;
        }

        /* ============================================================
         HOW IT WORKS
      ============================================================ */
        .steps {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2px;
            background: var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            position: relative;
        }

        .steps::before {
            content: "";
            position: absolute;
            top: 72px;
            left: calc(16.66% + 40px);
            right: calc(16.66% + 40px);
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            opacity: 0.4;
            pointer-events: none;
        }

        .step {
            background: var(--surface);
            padding: 48px 36px;
            position: relative;
            transition: background 0.3s;
        }

        .step:hover {
            background: var(--surface2);
        }

        .step-num {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: rgba(0, 232, 122, 0.1);
            border: 1.5px solid rgba(0, 232, 122, 0.3);
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 18px;
            color: var(--accent);
            margin-bottom: 28px;
        }

        .step-icon {
            font-size: 32px;
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .step-title {
            font-size: 21px;
            margin-bottom: 12px;
        }

        .step-text {
            font-size: 14px;
            color: var(--text2);
            line-height: 1.75;
        }

        /* ============================================================
         BENEFITS
      ============================================================ */
        .benefits-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .benefit-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 36px 32px;
            position: relative;
            overflow: hidden;
            transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
        }

        .benefit-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--accent);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        .benefit-card:hover {
            border-color: rgba(0, 232, 122, 0.25);
            transform: translateY(-4px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        }

        .benefit-card:hover::before {
            transform: scaleX(1);
        }

        .benefit-icon {
            font-size: 36px;
            margin-bottom: 20px;
            display: block;
            line-height: 1.2;
        }

        .benefit-title {
            font-size: 20px;
            margin-bottom: 12px;
        }

        .benefit-text {
            font-size: 14px;
            color: var(--text2);
            line-height: 1.75;
        }

        .benefit-metric {
            margin-top: 20px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--accent);
            background: rgba(0, 232, 122, 0.08);
            border-radius: 100px;
            padding: 5px 14px;
        }

        /* ============================================================
         SOCIAL PROOF
      ============================================================ */
        #social-proof {
            position: relative;
            overflow: hidden;
        }

        #social-proof::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(0, 232, 122, 0.04) 0%, transparent 70%);
            pointer-events: none;
        }

        .metrics-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2px;
            background: var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            margin-bottom: 64px;
            position: relative;
        }

        .metric-block {
            background: var(--surface);
            padding: 36px 28px;
            text-align: center;
        }

        .metric-num {
            font-family: var(--font-display);
            font-stretch: 90%;
            font-size: clamp(32px, 4vw, 48px);
            font-weight: 700;
            letter-spacing: -0.03em;
            font-variant-numeric: tabular-nums;
            color: var(--accent);
            display: block;
            margin-bottom: 8px;
        }

        .metric-label {
            font-size: 13px;
            color: var(--text2);
        }

        .testimonials {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            position: relative;
        }

        .testi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 36px 32px;
            display: flex;
            flex-direction: column;
            transition: border-color 0.3s, box-shadow 0.3s;
        }

        .testi-card:hover {
            border-color: rgba(255, 255, 255, 0.15);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .testi-quote {
            font-size: 15px;
            color: var(--text2);
            line-height: 1.8;
            margin-bottom: 28px;
            font-style: italic;
            flex: 1;
        }

        .testi-quote p::before {
            content: "\201C" / "";
            color: var(--accent);
            font-style: normal;
            font-size: 24px;
        }

        .testi-author {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .testi-avatar {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 18px;
            color: #000;
        }

        .ta-green {
            background: linear-gradient(135deg, var(--accent), var(--accent2));
        }

        .ta-blue {
            background: linear-gradient(135deg, #4facfe, #00f2fe);
        }

        .ta-gold {
            background: linear-gradient(135deg, #f5c842, #f09819);
        }

        .testi-name {
            font-family: var(--font-display);
            font-stretch: 90%;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 2px;
            font-style: normal;
        }

        .testi-role {
            font-size: 13px;
            color: var(--muted);
        }

        .testi-result {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: var(--accent);
        }

        /* ============================================================
         PRICING
      ============================================================ */
        .pricing-card {
            max-width: 540px;
            margin: 0 auto;
            background: var(--surface);
            border: 1px solid rgba(0, 232, 122, 0.3);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 0 80px rgba(0, 232, 122, 0.08);
        }

        .pricing-badge {
            background: var(--accent);
            color: #000;
            font-family: var(--font-display);
            font-stretch: 90%;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            text-align: center;
            padding: 8px 12px;
        }

        .pricing-body {
            padding: 48px;
        }

        .pricing-plan {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 20px;
        }

        .pricing-price {
            display: flex;
            align-items: flex-end;
            gap: 4px;
            margin-bottom: 8px;
        }

        .price-currency {
            font-family: var(--font-display);
            font-size: 24px;
            font-weight: 700;
            color: var(--text2);
            padding-bottom: 8px;
        }

        .price-value {
            font-family: var(--font-display);
            font-stretch: 90%;
            font-size: 72px;
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 1;
        }

        .price-period {
            font-size: 16px;
            color: var(--text2);
            padding-bottom: 12px;
        }

        .pricing-trial {
            font-size: 14px;
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 36px;
        }

        .pricing-features {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-bottom: 36px;
        }

        .pricing-features li {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 15px;
            color: var(--text2);
        }

        .pricing-features li::before {
            content: "✓" / "";
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: rgba(0, 232, 122, 0.15);
            color: var(--accent);
            font-size: 12px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .pricing-cta {
            width: 100%;
            padding: 18px;
        }

        .pricing-guarantee {
            margin-top: 20px;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 13px;
            color: var(--muted);
        }

        /* ============================================================
         FAQ
      ============================================================ */
        .faq-list {
            max-width: 720px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 2px;
            background: var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .faq-item {
            background: var(--surface);
        }

        .faq-item h3 {
            font: inherit;
            letter-spacing: normal;
        }

        .faq-question {
            width: 100%;
            background: none;
            border: none;
            padding: 24px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            cursor: pointer;
            text-align: left;
            color: var(--text);
            font-family: var(--font-body);
            font-size: 16px;
            font-weight: 600;
            line-height: 1.4;
            transition: background 0.2s;
        }

        .faq-question:hover {
            background: var(--surface2);
        }

        .faq-question:focus-visible {
            outline-offset: -3px;
        }

        .faq-chevron {
            flex-shrink: 0;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            transition: transform 0.3s, background 0.2s;
        }

        .faq-item.open .faq-chevron {
            transform: rotate(180deg);
            background: rgba(0, 232, 122, 0.15);
            color: var(--accent);
        }

        /* Altura animada sem max-height fixo; conteúdo fechado fica invisível p/ leitores de tela e tab */
        .faq-answer {
            display: grid;
            grid-template-rows: 0fr;
            visibility: hidden;
            transition: grid-template-rows 0.4s var(--ease), visibility 0s linear 0.4s;
        }

        .faq-item.open .faq-answer {
            grid-template-rows: 1fr;
            visibility: visible;
            transition: grid-template-rows 0.4s var(--ease), visibility 0s;
        }

        .faq-answer-inner {
            overflow: hidden;
            min-height: 0;
        }

        .faq-answer-inner p {
            padding: 0 32px 28px;
            font-size: 15px;
            color: var(--text2);
            line-height: 1.75;
        }

        /* ============================================================
         FINAL CTA
      ============================================================ */
        .cta-box {
            background: var(--surface);
            border: 1px solid rgba(0, 232, 122, 0.2);
            border-radius: 28px;
            padding: 80px 60px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .cta-box::before {
            content: "";
            position: absolute;
            top: -1px;
            left: 20%;
            right: 20%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
        }

        .cta-box-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 500px;
            height: 300px;
            background: radial-gradient(ellipse, rgba(0, 232, 122, 0.08) 0%, transparent 70%);
            pointer-events: none;
        }

        .cta-title {
            font-size: clamp(32px, 5vw, 60px);
            font-stretch: 85%;
            letter-spacing: -0.025em;
            margin-bottom: 20px;
            position: relative;
        }

        .cta-title .accent {
            color: var(--accent);
        }

        .cta-sub {
            font-size: 18px;
            color: var(--text2);
            max-width: 480px;
            margin: 0 auto 44px;
            line-height: 1.7;
            position: relative;
        }

        .cta-actions {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 20px;
            position: relative;
        }

        .cta-fine {
            font-size: 13px;
            color: var(--muted);
            position: relative;
        }

        /* ============================================================
         FOOTER
      ============================================================ */
        footer {
            padding: 48px 0 32px;
            border-top: 1px solid var(--border);
        }

        .footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 24px;
        }

        .logo {
            font-family: var(--font-display);
            font-stretch: 90%;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .logo span {
            color: var(--accent);
        }

        .footer-links {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .footer-links a {
            font-size: 13px;
            color: var(--muted);
            padding: 8px 10px;
            border-radius: 6px;
            transition: color 0.2s;
        }

        .footer-links a:hover {
            color: var(--text);
        }

        .footer-copy {
            font-size: 13px;
            color: var(--muted);
        }

        /* Faíscas do botão (micro-interação) */
        .spark {
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: var(--accent);
            transform: translate(-50%, -50%);
            animation: sparkFly 0.6s ease-out forwards;
        }

        @keyframes sparkFly {
            0% {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1);
            }

            100% {
                opacity: 0;
                transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0);
            }
        }

        /* ============================================================
         RESPONSIVE
      ============================================================ */
        @media (max-width: 900px) {

            #problem,
            #how,
            #benefits,
            #social-proof,
            #pricing,
            #faq,
            #final-cta {
                padding: 72px 0;
            }

            .section-header {
                margin-bottom: 48px;
            }

            .pas-grid {
                grid-template-columns: 1fr;
            }

            .pas-card--solution {
                grid-column: span 1;
            }

            .steps {
                grid-template-columns: 1fr;
            }

            .steps::before {
                display: none;
            }

            .benefits-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .testimonials {
                grid-template-columns: 1fr;
            }

            .metrics-row {
                grid-template-columns: repeat(2, 1fr);
            }

            .cta-box {
                padding: 56px 28px;
            }

            .pricing-body {
                padding: 36px 28px;
            }
        }

        @media (max-width: 640px) {
            .container {
                padding: 0 20px;
            }

            #hero {
                padding: 88px 0 56px;
            }

            .benefits-grid {
                grid-template-columns: 1fr;
            }

            .hero-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .hero-social-proof {
                flex-direction: column;
                align-items: flex-start;
            }

            .sp-divider {
                display: none;
            }

            .btn,
            .btn-lg {
                padding: 16px 24px;
                font-size: 16px;
            }

            .pas-card,
            .step {
                padding: 36px 24px;
            }

            .benefit-card,
            .testi-card {
                padding: 28px 24px;
            }

            .metric-block {
                padding: 28px 16px;
            }

            .pricing-body {
                padding: 32px 22px;
            }

            .price-value {
                font-size: 60px;
            }

            .cta-box {
                padding: 44px 20px;
            }

            .cta-actions .btn {
                width: 100%;
            }

            .footer-inner {
                flex-direction: column;
                text-align: center;
            }

            .faq-question {
                padding: 20px;
                font-size: 15px;
            }

            .faq-answer-inner p {
                padding: 0 20px 24px;
            }
        }

        /* ============================================================
         MOVIMENTO REDUZIDO
      ============================================================ */
        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                transition-delay: 0s !important;
            }

            .js .reveal {
                opacity: 1;
            }

            .js .reveal.visible {
                animation: none;
            }
        }
    </style>

</head>

